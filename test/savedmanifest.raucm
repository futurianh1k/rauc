[update]
compatible=BarCorp FooBazzer
version=2011.03-1

[bundle]
format=plain

[handler]
filename=myhandler.sh
args=--foo

[hooks]
filename=hook.sh
hooks=install-check;

[image.rootfs]
sha256=c8af04e62bad4ab75dafd22119026e5e3943f385bdcbe7731a4938102453754c
filename=myrootimg.ext4
type=ext4
hooks=pre-install;post-install;

[image.rootfs.variant-1]
sha256=768c36e72bedd35dac67c39b6145f97ef174179f5903a31c4c03abc0eb5d954c
filename=myrootimg_variant1.ext4
type=ext4
hooks=pre-install;post-install;
adaptive=invalid-method;another-invalid-method;

[image.appfs/app-a]
sha256=4e7e45db749b073eda450d30c978c7e2f6035b057d3e33ac4c61d69ce5155313
filename=myappimg.ext4
convert=invalid-convert;another-invalid-convert;
converted=invalid-converted;another-invalid-converted;

[meta.example]
counter=42

[meta.foocorp]
release-notes=https://foocorp.example/releases/release-notes-2015.04-1.rst
release-type=beta
